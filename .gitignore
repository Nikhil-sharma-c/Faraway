*.egg

# Frontend build output (regenerated by `npm run build`)
frontend/dist/

# Testing & Scratch directories
scratch/
.pytest_cache/
.coverage
htmlcov/
*.log

# Project specific transient artifacts
frontend/legacy/static/reports/
backend/reports/
snapshot_tmp.json
snapshot.json

# ---- Model weights (large; auto-download on first run) ----
# YOLO / Ultralytics weights
*.pt
