*.crt
*.pfx
*.p12
*.pkcs12
credentials.json
service_account.json
service-account*.json
client_secret*.json

# Virtual environment & Dependencies
venv/
.venv/
env/
ENV/
node_modules/

# Python cache & build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
